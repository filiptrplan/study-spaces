# Copy to .env in the repo root (next to compose.prod.yaml).

# At least 32 random alphanumeric characters (the password goes into a URL): openssl rand -hex 32
POSTGRES_PASSWORD=

# Where the app listens for your TLS proxy (plain HTTP). Use APP_BIND=0.0.0.0 to expose it.
APP_BIND=127.0.0.1
APP_PORT=8080

# guest: public, no sign-up. Every browser gets its own anonymous account in a cookie.
# proxy: identity comes from the headers below, set by a login proxy (see docs/vps.md).
# demo: no login, everyone is one shared user. For trying the app out only.
AUTH_MODE=guest
# Set to false only when testing over plain http (not localhost).
GUEST_COOKIE_SECURE=true
USER_ID_HEADER=X-User-Id
USER_NAME_HEADER=X-User-Name

# Admins: by email (proxy mode), e.g. ["me@example.com"], or by user id (any mode; the
# id is in /api/v1/me when signed in). Guests have no email, so use ids there.
ADMIN_EMAILS=[]
ADMIN_USER_IDS=[]

# false hides Friends and study parties. Fixed at build time: rebuild after changing.
SOCIAL_ENABLED=true
