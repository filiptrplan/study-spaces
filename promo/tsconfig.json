{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "@mantine/*": ["../frontend/node_modules/@mantine/*"],
      "react-router": ["../frontend/node_modules/react-router"],
      "@tanstack/*": ["../frontend/node_modules/@tanstack/*"]
    }
  },
  "include": ["src"]
}
